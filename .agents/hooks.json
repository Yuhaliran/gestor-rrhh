{
  "permisos-por-rol": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|view_file|list_dir|find_by_name|grep_search|run_command|invoke_subagent|define_subagent|send_message|manage_subagents",
        "hooks": [
