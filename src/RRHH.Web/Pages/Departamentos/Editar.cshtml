@page "{id:int?}"
@model RRHH.Web.Pages.Departamentos.EditarModel
@using RRHH.Contratos.Paises
@{
    ViewData["Title"] = Model.Id is null ? "Nuevo departamento" : "Editar departamento";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="col-md-8 col-lg-6">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Datos.PaisId" class="form-label">País</label>
        @if (Model.Id is null)
        {
            <select asp-for="Datos.PaisId" asp-items="new SelectList(Model.Paises, nameof(PaisDto.Id), nameof(PaisDto.Nombre))" class="form-select">
                <option value="">Elegí un país…</option>
            </select>
        }
        else
        {
            @* RN8: el país no cambia al editar *@
            <input type="hidden" asp-for="Datos.PaisId" />
            <input class="form-control" value="@Model.PaisNombre" readonly />
        }
        <span asp-validation-for="Datos.PaisId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Datos.Nombre" class="form-label">Nombre</label>
        <input asp-for="Datos.Nombre" class="form-control" maxlength="100" />
        <span asp-validation-for="Datos.Nombre" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-link" asp-page="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
