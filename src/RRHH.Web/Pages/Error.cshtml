@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">No se pudo completar la operación</h1>
<p>Ocurrió un error inesperado. Verificá que la API esté en ejecución y volvé a intentarlo.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador del pedido:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-primary" asp-page="/Index">Volver al inicio</a>
