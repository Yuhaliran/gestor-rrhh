@page
@model ErrorModel
@{
    var (titulo, mensaje) = Model.Explicacion;
    ViewData["Title"] = titulo;
}

<h1 class="text-danger">@titulo</h1>
<p>@mensaje</p>

@if (Model.MostrarId)
{
    <p>
        <strong>Identificador del pedido:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="btn btn-primary" asp-page="/Index">Volver al inicio</a>
