@model Paginacion
@* Paginador de los listados: enlaces a la misma página con otro número, conservando la búsqueda *@
<div class="d-flex justify-content-between align-items-center">
    <span class="text-muted">@Model.Total registro@(Model.Total == 1 ? "" : "s")</span>
    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Páginas">
            <ul class="pagination mb-0">
                <li class="page-item @(Model.Numero <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-route-pagina="@(Model.Numero - 1)" asp-route-buscar="@Model.Buscar">Anterior</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@Model.Numero de @Model.TotalPaginas</span></li>
                <li class="page-item @(Model.Numero >= Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-route-pagina="@(Model.Numero + 1)" asp-route-buscar="@Model.Buscar">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>
